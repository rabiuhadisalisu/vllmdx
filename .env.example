# ── Model Configuration ─────────────────────────────────────────
# HuggingFace model ID or absolute local path
MODEL_ID=microsoft/Phi-3.5-mini-instruct
# MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
# MODEL_ID=/models/local-gguf-model  # local path

# ── Server Settings ─────────────────────────────────────────────
VLLM_PORT=8000
MAX_MODEL_LEN=8192
# API key to protect your endpoint (optional but recommended)
VLLM_API_KEY=your-secret-key-here

# ── HuggingFace ─────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here  # needed for gated models (Llama, etc.)

# ── CPU Settings (only if no GPU) ───────────────────────────────
CPU_THREADS=8
CPU_BIND=0-7

# ── Cloudflare Tunnel ───────────────────────────────────────────
# Get this from: Cloudflare Zero Trust > Networks > Tunnels
CF_TUNNEL_TOKEN=eyJhIjoiXXXXXXXXXXXXXXXXXXXXXX...

# ── Performance Tuning ──────────────────────────────────────────
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_BATCHED_TOKENS=16384
TENSOR_PARALLEL_SIZE=1  # increase for multi-GPU
